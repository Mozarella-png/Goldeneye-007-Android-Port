@@ -279,3 +286,26 @@
 
     return 0;
 }
+
+#if defined(__ANDROID__)
+/* SDLActivity resolves SDL_main in libmain.so and calls it on the native
+ * thread. Switch the working directory to the app's external files dir so
+ * every existing data/-relative path (ROM, ge007.ini, ge007.eep, sidecars)
+ * works unchanged. The ROM goes in <files>/data/ge007.ntsc-final.z64. */
+int SDL_main(int argc, char **argv)
+{
+    const char *base = SDL_AndroidGetExternalStoragePath();
+    if (base && chdir(base) == 0) {
+        mkdir("data", 0775);  /* best effort; ignored if it exists */
+    } else {
+        sysLogPrintf(LOG_ERROR, "Android: could not enter the app data dir (%s)",
+                     base ? base : "(null)");
+    }
+    return portMain(argc, argv);
+}
+#else
+int main(int argc, char **argv)
+{
+    return portMain(argc, argv);
+}
+#endif
